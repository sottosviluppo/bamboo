{
    "name": "sottosviluppo/bamboo",
    "description": "Bamboo, an e-commerce suite built with Elcodi",
    "keywords": [
        "elcodi",
        "bamboo",
        "symfony",
        "ecommerce"
    ],
    "support": {
        "email": "devs@elcodi.com",
        "forum": "https://gitter.im/elcodi/bamboo",
        "source": "https://github.com/elcodi/bamboo",
        "issues": "https://github.com/elcodi/bamboo/issues"
    },
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Marc Morera",
            "email": "yuhu@mmoreram.com"
        },
        {
            "name": "Aldo Chiecchia",
            "email": "aldo.chiecchia@befactory.es"
        },
        {
            "name": "The Awesome Elcodi Community",
            "homepage": "https://github.com/elcodi/bamboo/contributors"
        }
    ],
    "require": {
        "php": "^5.4|^7.0",
        "ext-bcmath": "*",
        "ext-openssl": "*",

        "symfony/symfony": "2.8.42",
        "symfony/assetic-bundle": "^2.7|^3.0",
        "symfony/swiftmailer-bundle": "^2.3.8|^3.0",
        "symfony/monolog-bundle": "3.1.2 as 2.12",

        "ocramius/proxy-manager": "^1.0",
        "doctrine/orm": "^2.5",
        "doctrine/dbal": "^2.5",
        "doctrine/common": "^2.5",
        "doctrine/doctrine-bundle": "^1.5.0",
        "doctrine/annotations": "^1.2",
        "doctrine/doctrine-fixtures-bundle": "^2.2",
        "doctrine/doctrine-migrations-bundle": "^1.0",

        "twig/twig": "^1.23",
        "twig/extensions": "^1.0",
        "sensio/distribution-bundle": "^3.0",
        "sensio/framework-extra-bundle": "^3.0",
        "jms/aop-bundle": "^1.0",
        "jms/serializer-bundle": "^0.13.0",

        "guzzlehttp/guzzle": "^5.2",
        "ornicar/gravatar-bundle" : "1.1.3",
        "knplabs/knp-gaufrette-bundle": "^0.3.0",
        "incenteev/composer-parameter-handler": "^2.0",
        "hwi/oauth-bundle": "^0.4.0",
        "snc/redis-bundle": "^1.1.9",
        "predis/predis": "^1.0.1",
        "acasademont/i18n-routing-bundle": "2.0.0",

        "mmoreram/controller-extra-bundle": "1.2.1",
        "mmoreram/extractor": "^1.2",
        "mmoreram/http-headers-bundle": "1.1.0",
        "mmoreram/symfony-bundle-dependencies": "^1.1.1",

        "sottosviluppo/elcodi": "dev-develop",

        "sottosviluppo/paymentsuite": "^2.0",
        "friendsofsymfony/elastica-bundle": "^4.0-dev",
        "cocur/slugify": "^2.3",
        "knplabs/knp-paginator-bundle": "^2.5",
        "phpoffice/phpexcel": "~1.8.1",
        "tecnickcom/tcpdf": "6.3.5",
        "egeloen/ckeditor-bundle" : "~5.0",
        "elendev/roxyfileman-bundle": "1.2.0",
        "wikimedia/composer-merge-plugin": "2",
        "yectep/phpspreadsheet-bundle" : "0.0.4",
      "ext-dom": "*",
      "ext-json": "*"
    },
    "replace": {
        "elcodi-templates/template": "self.version",
        "elcodi-templates/store-template-bundle": "self.version",

        "elcodi-plugin/google-analytics": "self.version",
        "elcodi-plugin/pinterest": "self.version",
        "elcodi-plugin/product-csv": "self.version",
        "elcodi-plugin/store-setup-wizard": "self.version",
        "elcodi-plugin/disqus": "self.version",
        "elcodi-plugin/twitter": "self.version",
        "elcodi-plugin/facebook": "self.version",
        "elcodi-plugin/paypal-web-checkout": "self.version",
        "elcodi-plugin/stripe": "self.version",
        "elcodi-plugin/free-payment": "self.version",
        "elcodi-plugin/custom-shipping": "self.version"
    },
    "require-dev": {
        "doctrine/data-fixtures": "1.1.1",
        "behat/behat": "^3.0",
        "behat/symfony2-extension": "^2.0",
        "behat/mink-extension": "^2.0.1",
        "behat/mink-browserkit-driver": "^1.2",
        "behat/mink-selenium2-driver": "^1.2",
        "behat/mink": "^1.6",
        "phpunit/phpunit": "4.8.*",

        "mmoreram/php-formatter": "1.1.0",
        "friendsofphp/php-cs-fixer": "1.4.2",
        "visithor/visithor-bundle": "^0.2.0"
    },
    "suggest": {
        "ext-redis": "If doctrine cache works on top of redis"
    },
    "scripts": {
        "check-style": [
            "bin/php-cs-fixer fix --config-file=.php_cs || true",
            "bin/php-formatter f:u:s src || true",
            "bin/php-formatter f:u:s app || true",
            "bin/php-formatter f:h:f src || true",
            "bin/php-formatter f:h:f app || true"
        ],
        "compile": [
            "app/console -n doctrine:migrations:status",
            "app/console -n doctrine:migrations:migrate",
            "app/console -n elcodi:plugins:load",
            "app/console -n assets:install",
            "app/console -n assetic:dump"
        ],
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "@ckeditorDir",
            "@ckeditorInstall"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::clearCache",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installAssets",
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::installRequirementsFile",
            "@ckeditorInstall"
        ],
        "test": [
            "bin/behat",
            "bin/phpunit -c app",
            "app/console -n visithor:go --format=pretty --env=test"
        ],
        "ckeditorInstall":[
            "php app/console cache:clear --env=prod --no-warmup",
            "php app/console assets:install --env=prod",
            "php app/console assetic:dump --env=prod"
        ],
        "ckeditorDir": [
            "mkdir web/ckeditor_uploads"
        ]
    },
    "autoload": {
        "psr-4": {
            "": [
                "src/"
            ],
            "Elcodi\\": [
                "src/Elcodi"
            ]
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "files": [
            "vendor/phpunit/phpunit/src/Framework/Assert/Functions.php"
        ]
    },
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": false
        }
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-web-dir": "web",
        "incenteev-parameters": {
            "file": "app/config/parameters.yml"
        },
        "merge-plugin": {
            "include": [
                "composer_custom.json",
                "src/Elcodi/Plugin/*/composer_custom.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        }
    }
}
